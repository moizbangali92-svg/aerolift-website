# Response headers for Netlify / Cloudflare Pages. Copied to the publish root
# by scripts/build.mjs. Hosts that don't read this file simply ignore it.
#
# Caching note: none of the assets are content-hashed, so anything that can be
# replaced under the same filename is revalidated rather than pinned. Only the
# fonts are safe to freeze — a different weight is a different filename.

# script-src carries a SHA-256 hash instead of 'unsafe-inline'. Every page
# opens <head> with the same one-line inline script that drops the `no-js`
# class, and that line is byte-identical across all of them, so a single hash
# covers the site. If you change that line — even its whitespace or quoting —
# the hash stops matching and the script is blocked silently: the `no-js`
# class survives, `.js-only` controls stay hidden and `.reveal` content never
# animates in. Recompute with:
#   printf "%s" "<the exact line>" | openssl dgst -sha256 -binary | openssl base64
# style-src keeps 'unsafe-inline': Tailwind emits inline style attributes.
#
# connect-src and form-action are 'self' alone. The quote form posts to
# /api/quote on this origin, handled by worker/quote.js — no third-party form
# service is involved, so no third-party host needs permitting. If the backend
# is ever moved off this origin, both directives have to name the new host or
# the submit fails in a way that looks exactly like an outage.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-tuKyZn/3ycw/MNMDii/kvSPrelo6SCsJSecqb1n2neg='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# HTML deliberately has no rule. These patterns match the REQUEST path, and the
# site serves pretty URLs (/about/, not /about/index.html), so a `/*.html` rule
# matches nothing. Cloudflare's default for HTML is already
# `public, max-age=0, must-revalidate` — revalidate every time, which is what we
# want. Verified with `wrangler dev`, not assumed.

# Unhashed CSS/JS — stored, but revalidated on every visit (a 304 is cheap).
/css/style.css
  Cache-Control: public, no-cache
/js/main.js
  Cache-Control: public, no-cache

# Images and the catalogue change rarely; a week of staleness is acceptable.
/assets/*
  Cache-Control: public, max-age=604800

# The catalogue must not be indexed: a PDF full of capacity tables competes
# with the product pages for the same specification queries, and it cannot
# carry a canonical tag or convert a visitor. Matched by full path rather than
# a `*.pdf` glob — these patterns match the request path, and a mid-path glob
# is exactly the kind of rule that silently matches nothing.
/assets/aerolift-catalogue-2026.pdf
  X-Robots-Tag: noindex

# Font filenames carry the family and weight, so they are safe to freeze.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
