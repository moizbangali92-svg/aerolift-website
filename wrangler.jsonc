{
  "$schema": "node_modules/wrangler/config-schema.json",

  // NOTE: `name` must match the Worker this repo is connected to in the
  // Cloudflare dashboard. If it does not, `wrangler deploy` silently creates a
  // SECOND Worker and the custom domain stays on the old one.
  "name": "aerolift-website",

  // There is no Worker script, so this date gates nothing at runtime. It is
  // held a little behind today's date on purpose: a build environment whose
  // runtime is older than the compatibility date can refuse the deploy, and
  // there is nothing to gain here by sitting on the newest one.
  "compatibility_date": "2026-08-01",

  // The Worker script: redirect the apex to www, answer POST /api/quote, and
  // hand every other request straight to the asset server. See worker/index.js
  // for why the redirect is not a dashboard rule and why passing asset
  // responses through untouched is what keeps the _headers rules.
  "main": "./worker/index.js",

  // Non-secret configuration for the quote form. The API key is NOT here — it
  // is a secret, set with `wrangler secret put MAILCHANNELS_API_KEY` (or in
  // the dashboard), so it never enters the repo. worker/quote.js answers 503
  // and logs when it is missing, rather than failing silently.
  "vars": {
    "QUOTE_TO": "sales@aerolift-cranes.com",
    // Must stay on a domain the DKIM key and Domain Lockdown record authorise
    // — see DEPLOY.md. The visitor's own address goes in Reply-To, never here.
    "QUOTE_FROM": "website@aerolift-cranes.com"
  },

  "assets": {
    "directory": "./dist",

    // The script reaches the built site through this binding.
    "binding": "ASSETS",

    // Without this, assets are served FIRST and the script only runs when no
    // asset matches — so the redirect would never fire for "/" or any real
    // page. It has to see every request to be able to check the hostname.
    "run_worker_first": true,

    // Unmatched paths serve dist/404.html with a real 404 status, which is
    // what the branded 404 page is for. The default ("none") would return a
    // bare Cloudflare error page instead.
    "not_found_handling": "404-page",

    // Pages live at /about/index.html and are requested as /about/ — the
    // default handling already maps that correctly. Stated explicitly so a
    // future change to it is a deliberate decision, not a surprise.
    "html_handling": "auto-trailing-slash"
  }
}
